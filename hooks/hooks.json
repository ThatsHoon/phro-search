{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/egress.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plan_line.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
